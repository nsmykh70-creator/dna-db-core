    {
      "id": 6,
      "type": "timeseries",
      "title": "Запросы/с и ошибки/с (rate за 1 мин)",
      "description": "dnadb_cms_wire_queries_total / dnadb_cms_wire_errors_total. Постоянные ошибки — проверьте SQL-журнал DNA_LOG_SQL.",
      "datasource": {
        "type": "prometheus",
        "uid": "dna-db-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dna-db-prom"
          },
          "expr": "rate(dnadb_cms_wire_queries_total[1m])",
          "legendFormat": "запросы/с",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dna-db-prom"
          },
          "expr": "rate(dnadb_cms_wire_errors_total[1m])",
          "legendFormat": "ошибки/с",
          "refId": "B"
        }
      ]
    },
